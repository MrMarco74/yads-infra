# YADS Production Server — Environment Variables
# Copy to .env and fill in values. Never commit .env!

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://yads:changeme@db:5432/yads

# ── Application Secrets ───────────────────────────────────────────────────────
SECRET_KEY=
SIGNING_KEY=
REFRESH_SECRET=
YADS_ENCRYPTION_KEY=

# ── Message Broker ────────────────────────────────────────────────────────────
RABBITMQ_PASSWORD=changeme
REDIS_PASSWORD=

# ── Registry (Hetzner Object Storage / S3) ────────────────────────────────────
REGISTRY_S3_ACCESS_KEY=
REGISTRY_S3_SECRET_KEY=
REGISTRY_S3_BUCKET=yads-registry
REGISTRY_HTTP_SECRET=

# ── YADS Settings ─────────────────────────────────────────────────────────────
MFA_ENABLED=true
AUTH_MODE=local
SETUP_TOKEN=
SUPPORT_PORTAL_VERIFY_SSL=true
SHADOWTWIN_URL=http://shadowtwin:8088
METRICS_ENABLED=false
METRICS_TOKEN=

# ── First-time Setup (remove after initial deploy) ────────────────────────────
# YADS_ADMIN_USER=admin
# YADS_ADMIN_PASS=changeme
# LICENSE_KEY=
